<?xml version="1.0" encoding="utf-8"?>
<!--
    Alguns portais de consulta de NFC-e (ex.: Sefaz-PR) ainda servem a DANFCe em HTTP puro,
    não HTTPS — o Android bloqueia texto claro por padrão desde a API 28. Liberamos isso só
    para domínios .gov.br (qualquer subdomínio), nunca para o resto do app: a chamada à
    OpenRouter continua exigindo HTTPS normalmente, sem exceção nenhuma.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">gov.br</domain>
    </domain-config>
</network-security-config>
